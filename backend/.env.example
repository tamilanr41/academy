# ---------------------------------------------------------------
# Academy backend — copy to .env and fill in real values.
# NEVER commit the real .env file.
# ---------------------------------------------------------------

NODE_ENV=development
PORT=5000

# --- Database (MongoDB Atlas or local) ---
MONGODB_URI=mongodb://127.0.0.1:27017/academy
# Atlas example:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/academy?retryWrites=true&w=majority

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-min-32-chars
JWT_EXPIRES_IN=7d
COOKIE_MAX_AGE_MS=604800000

# --- URLs / CORS ---
FRONTEND_URL=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:5000
CORS_ORIGINS=http://localhost:3000
# Set to 1 when running behind a reverse proxy / load balancer
TRUST_PROXY=0

# --- First Super Admin (used only by the seed script) ---
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=admin@academy.example
SUPER_ADMIN_PASSWORD=ChangeThisStrongPassword123

# --- Cloudinary (optional; local disk uploads are used when empty) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Email / SMTP (optional; emails are logged to console when empty) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Elevate Academy <no-reply@academy.example>"

# --- Razorpay (optional; offline workflow is used when empty) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Rate limiting / uploads ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
MAX_UPLOAD_SIZE=5242880
MAINTENANCE_MODE=false
