{
  "name": "academy-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Academy Management Platform - Express + MongoDB REST API",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node src/seeders/runSeeder.js",
    "seed:superadmin": "node src/seeders/seedSuperAdmin.js",
    "clear:demo-users": "node src/seeders/clearDemoUsers.js",
    "test": "cross-env NODE_ENV=test MONGODB_URI=mongodb://127.0.0.1:27017/academy_test NODE_OPTIONS=--experimental-vm-modules jest --runInBand --forceExit",
    "test:watch": "cross-env NODE_ENV=test MONGODB_URI=mongodb://127.0.0.1:27017/academy_test NODE_OPTIONS=--experimental-vm-modules jest --watch --runInBand"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.7.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.2",
    "morgan": "^1.10.1",
    "multer": "^2.4.0",
    "nodemailer": "^10.1.2",
    "razorpay": "^2.9.7",
    "slugify": "^1.6.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "jest": "^30.1.3",
    "nodemon": "^3.1.10",
    "supertest": "^7.1.4"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/setup-env.js"
    ],
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "verbose": true
  }
}
