# ---------------------------------------------------------------------------
# Magma Minds Academy — PRODUCTION environment
#
#   cp .env.production.example .env      (docker compose reads this file)
#   ...edit every value marked CHANGE-ME, then: docker compose up -d
#
# This file is git-ignored. NEVER commit real secrets.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
NODE_ENV=production
TZ=Asia/Kolkata
PORT=5000

# Public URL of the site as visitors reach it.
#   No domain yet  ->  http://YOUR_SERVER_IP
#   With a domain  ->  https://magmamindsacademy.com
NEXT_PUBLIC_SITE_URL=http://YOUR_SERVER_IP
FRONTEND_URL=http://YOUR_SERVER_IP
# Comma-separated allowlist (add https://www.<domain> too when you have one)
CORS_ORIGINS=http://YOUR_SERVER_IP
BACKEND_PUBLIC_URL=http://YOUR_SERVER_IP

# Behind nginx: forward X-Forwarded-* / real client IPs to Express
TRUST_PROXY=1

# --- Web image (build-time) --------------------------------------------------
# docker-compose passes these as Docker build args, so they are baked into the
# Next.js build. BACKEND_URL is fixed to http://backend:5000 inside compose.
# After changing NEXT_PUBLIC_SITE_URL (or enabling HTTPS) rebuild the web image:
#   docker compose build frontend && docker compose up -d

# --- MongoDB (the compose `mongo` service) ----------------------------------
MONGO_ROOT_USERNAME=academy
MONGO_ROOT_PASSWORD=CHANGE-ME-strong-mongo-password
# Not needed here: docker-compose builds MONGODB_URI from the two values above.
# Only set this when pointing at an external database (Atlas, etc.):
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/academy?retryWrites=true&w=majority

# --- Auth -------------------------------------------------------------------
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE-ME-generate-a-48-byte-hex-secret
JWT_EXPIRES_IN=7d
COOKIE_MAX_AGE_MS=604800000
# Auth cookie `Secure` flag. `true` requires HTTPS.
#   HTTPS (domain or self-signed) -> true   (recommended)
#   Plain HTTP on a bare IP       -> false  (temporary; JWT travels unencrypted!)
COOKIE_SECURE=false

# --- First super admin (only read by the seed scripts) ----------------------
SUPER_ADMIN_NAME=Magma Minds Admin
SUPER_ADMIN_EMAIL=magmaminds@gmail.com
SUPER_ADMIN_PASSWORD=CHANGE-ME-strong-admin-password

# --- Uploads ----------------------------------------------------------------
# Uploads are written to the `uploads-data` volume unless Cloudinary is set.
MAX_UPLOAD_SIZE=5242880

# --- Cloudinary (optional; leave empty to store files on the server) --------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Email / SMTP (optional; emails are logged to the container when empty) -
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Magma Minds Academy <no-reply@magmaminds.example>

# --- Razorpay (optional; offline payment workflow is used when empty) -------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Rate limiting / maintenance -------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
MAINTENANCE_MODE=false
